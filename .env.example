# Copia in `.env` per sviluppo locale (`npm run dev`).
# Produzione: Vercel → Project → Settings → Environment Variables.
# Non committare `.env`.

AI_GATEWAY_API_KEY=
# Opzionale — modello gateway formato provider/nome (es. openai/gpt-4o-mini, openai/gpt-5.4)
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Form contatti — EmailJS (https://www.emailjs.com/)
# 1. Crea un Email Service collegato a ianuacare@gmail.com
# 2. Crea un template con variabili: {{from_email}}, {{from_name}}, {{message}}, {{source}}
#    - Destinatario: ianuacare@gmail.com
#    - Reply-To: {{from_email}}
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
