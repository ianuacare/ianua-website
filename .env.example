# Copia in `.env` per sviluppo locale (`npm run dev`).
# Produzione: Vercel → Project → Settings → Environment Variables.
# Non committare `.env`.

AI_GATEWAY_API_KEY=
# Opzionale — modello gateway formato provider/nome (es. openai/gpt-4o-mini, openai/gpt-5.4)
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Form contatti — EmailJS (https://www.emailjs.com/)
# 1. Crea un Email Service collegato a ianuacare@gmail.com
# 2. Template notifica interna (es. EmailJS preset "Contact Us"):
#    - To: ianuacare@gmail.com  |  Reply-To: {{email}}  |  From Name: {{name}}
#    - Subject: Contact Us: {{title}}
#    - Corpo: {{name}}, {{time}}, {{message}}  (opzionale: {{source}})
# 3. EmailJS → Account → Security:
#    - Domains: https://www.ianuacare.it, https://ianuacare.it, http://localhost:5173
#    - Abilita "Allow EmailJS API for non-browser applications"
# Produzione: preferisci variabili server (runtime, senza redeploy per ogni cambio ID):
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
# Opzionale se l'account EmailJS richiede access token server-side:
EMAILJS_PRIVATE_KEY=
# Fallback locale con `npm run dev` (invio dal browser; richiede dominio in whitelist EmailJS):
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
